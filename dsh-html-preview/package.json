{
  "name": "@local/dsh-html-preview",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Static HTML and CSS previews beneath completed assistant replies. Original HTML remains in model context.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "core.js", "client-source.js", "vendor/*", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
