{
  "name": "@local/dsh-token-cost",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Real-time token cost in CNY from the official DeepSeek rate card, priced per request across a rate timeline, peak/off-peak and cache-bucket aware.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "tariff.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
